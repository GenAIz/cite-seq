{
  "metadata": {
    "project_name": "QuickTest",
    "description": "Minimal quick test"
  },
  "paths": {
    "input_data": {
      "rna_path": "/raw/rna.h5ad",
      "adt_path": null,
      "metadata_file": null
    },
    "output_dir": "/results",
    "logs_dir": "/logs"
  },
  "output_files": {
    "cell_type_annotation": "annotated_seurat.rds",
    "aggregate_ml": "ml_ready_aggregate.xlsx"
  },
  "execution": {
    "mode": "chained",
    "steps": [
      "load_data",
      "process_seurat",
      "cell_type_annotation",
      "aggregate_ml"
    ],
    "verbose": true,
    "n_cores": 4
  },
  "load_data": {
    "project_name": "QuickTest",
    "species_name": "human"
  },
  "add_metadata": {
    "enabled": false
  },
  "processing": {
    "use_disk_backed": true,
    "adt_filters": {
      "keep_pattern": null,
      "drop_pattern": "isotype"
    },
    "normalization": {
      "rna_method": "LogNormalize",
      "adt_method": "CLR"
    },
    "qc_filters": {
      "min_features": 200,
      "max_features": 5000,
      "max_percent_mt": 20,
      "max_percent_rp": 40,
      "min_cells": 3,
      "min_cells_per_sample": 500
    },
    "features": {
      "n_features": 3000
    },
    "reduction": {
      "pca_dims_rna": 30,
      "pca_dims_adt": 10
    },
    "clustering": {
      "rna_resolution": 1.0,
      "wnn_resolution": 1.0,
      "k_param": 20
    }
  },
  "aggregation": {
    "participant_col": "Participant ID",
    "timepoint_col": "Timepoint",
    "celltype_cols": [
      "Prediction"
    ],
    "preserve_columns": []
  },
  "batch": {
    "column": "orig.ident",
    "detect": true,
    "correct": "auto"
  }
}
